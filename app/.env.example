# Required provider credentials
# Required for live Qloo-backed research.
QLOO_API_KEY=

# Optional provider configuration
# Gemini enables optional structured interpretation; the remaining values
# override provider defaults only when needed.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE_URL=
GEMINI_API_ENDPOINT=
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_MS=
GEMINI_OVERALL_TIMEOUT_MS=
GEMINI_MAX_ATTEMPTS=
GEMINI_RETRY_BASE_DELAY_MS=
QLOO_API_BASE_URL=
QLOO_SEARCH_PATH=
QLOO_INSIGHTS_PATH=
QLOO_TIMEOUT_MS=
QLOO_OVERALL_TIMEOUT_MS=
QLOO_MAX_ATTEMPTS=
QLOO_RETRY_BASE_DELAY_MS=

# Optional infrastructure configuration
# No additional infrastructure settings are required for local startup.

# Request-protection settings
# Production request protection requires the Upstash values and HMAC secret.
# Local development may use the explicitly supported mode described in README.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=
REQUEST_PROTECTION_MODE=

# Development/evaluation-only settings
# Used only by the optional evaluation script; do not use as a provider endpoint.
MOSAIC_EVALUATION_BASE_URL=
